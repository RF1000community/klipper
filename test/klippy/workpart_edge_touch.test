# Test workpart_edge_touch (EDGE_TOUCH / COMPUTE_WORKPART).
# EDGE_TOUCH reads probe status last_test_position (the contact point from the
# most recent probe) instead of relying on the toolhead being parked there.
DICTIONARY atmega2560.dict
CONFIG workpart_edge_touch.cfg

# Start by homing the printer.
G28
G1 F6000

# Probe and record edge touches along X and Y.  The probe is run at the
# current XY position, and EDGE_TOUCH records the probe result.  Positions
# are chosen so COMPUTE_WORKPART gets non-degenerate fits.
G1 X0 Y0
PROBE
EDGE_TOUCH DIRECTION=X+
G1 X5 Y1
PROBE
EDGE_TOUCH DIRECTION=X+
G1 X6 Y0
PROBE
EDGE_TOUCH DIRECTION=Y+
G1 X0 Y5
PROBE
EDGE_TOUCH DIRECTION=Y+
COMPUTE_WORKPART
