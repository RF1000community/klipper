# Test case for probing along configurable directions (Z-, X, Y)
CONFIG probe_direction.cfg
DICTIONARY atmega2560.dict

# Start by homing the printer.
G28
G1 F6000

# Z / X / Y moves
G1 Z1
G1 X1
G1 Y1

# Default direction (z-) regression guard
PROBE

# Probe along explicit Z-
PROBE DIRECTION=Z-

# Probe along X+ / X-
PROBE DIRECTION=X+
PROBE DIRECTION=X-

# Probe along Y+ / Y-
PROBE DIRECTION=Y+
PROBE DIRECTION=Y-

# Accuracy path along a non-Z direction
PROBE_ACCURACY DIRECTION=Y-
PROBE_ACCURACY DIRECTION=X+ SAMPLES=3

# Move back to a safe location
G1 Z5 X50 Y50
